function publicMetadata_(db){const districts={};Object.keys(db.districts).forEach(function(name){const d=db.districts[name],meetings={};d.meetings.forEach(function(m){if(m.kind==='weekly-v1'&&m.cloud)meetings[m.round]=m.cloud.revision});districts[name]={updatedAt:d.updatedAt||'',meetings:meetings}});return {districts:districts,revision:db.revision||0}}
function publicRequest_(q){if(['load','submit','patch','attachment'].indexOf(q.action)<0)throw Error('不支援的操作');if(q.action==='load')return {metadata:publicMetadata_(read_(q.test===true))};const lock=LockService.getScriptLock();if(!lock.tryLock(25000))throw Error('目前有人正在送出，請稍後重試');try{const db=read_(q.test===true),p=q.payload||{};if(q.action==='submit'){validateMeeting_(p.record);if(!/^[a-zA-Z0-9-]{16,80}$/.test(p.requestId||''))throw Error('送出識別不符');const old=(db.districts[p.record.district]||empty_()).meetings.find(function(m){return m.kind==='weekly-v1'&&Number(m.round)===Number(p.record.round)});if(old&&old.cloud&&old.cloud.requestId===p.requestId)return {record:old,revision:db.revision};if(old&&old.cloud&&old.cloud.revision!==(p.baseRevision||0))throw Error('CONFLICT:本次資料已更新，請重新整理後再送出');p.docx=Utilities.base64Encode(makeWord_(p.record).getBytes());return submit_(db,p)}if(q.action==='patch'){const result=patch_(db,p);return {change:p.change,updatedAt:result.district.updatedAt,revision:result.revision}}const result=attachment_(db,p);return {attachment:result.attachment,updatedAt:db.districts[p.district].updatedAt,revision:db.revision}}finally{lock.releaseLock()}}
function xmlText_(v){return String(v??'').replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&apos;'}[c]})}
function fillWordXml_(xml,m){let found=false;xml=xml.replace(/<w:tbl\b[\s\S]*?<\/w:tbl>/g,function(table){if(table.indexOf('w:val="plan.0.date"')<0)return table;found=true;const rows=table.match(/<w:tr\b[\s\S]*?<\/w:tr>/g);if(!rows||rows.length<2)throw Error('Word 日期範本格式有誤');const plan=m.weekly.plan.map(function(entry,i){let row=rows[1].replace(/w:val="plan\.0\./g,'w:val="plan.'+i+'.');return row.replace(/<w:tc\b[\s\S]*?<\/w:tc>/,function(cell){return cell.replace(/<w:t\b[^>]*>[\s\S]*?<\/w:t>/,'<w:t>'+xmlText_(entry.label)+'</w:t>')})}).join('');let i=0;return table.replace(/<w:tr\b[\s\S]*?<\/w:tr>/g,function(row){return i++===0?row+plan:''})});if(!found)throw Error('找不到 Word 日期範本');const values=wordValues_(m);let id=9500;xml=xml.replace(/<w:sdt\b[\s\S]*?<\/w:sdt>/g,function(sdt){sdt=sdt.replace(/(<w:id\b[^>]*w:val=")[^"]*(")/g,function(_,a,b){return a+(id++)+b});const match=sdt.match(/<w:tag\b[^>]*w:val="([^"]+)"/);if(!match||!Object.prototype.hasOwnProperty.call(values,match[1]))return sdt;const value=String(values[match[1]]??'').trim()||'—';return sdt.replace(/(<w:sdtContent\b[^>]*>)([\s\S]*?)(<\/w:sdtContent>)/,function(_,a,body,b){let first=true;body=body.replace(/<w:t\b[^>]*>[\s\S]*?<\/w:t>/g,function(){if(!first)return '';first=false;return '<w:t xml:space="preserve">'+value.split(/\r?\n/).map(xmlText_).join('</w:t><w:br/><w:t xml:space="preserve">')+'</w:t>'});return a+body+b})});return xml.split('光興地區共六次週一運營').join(xmlText_(m.district)+'地區共'+(m.weekly.plan.length-2)+'次週一運營')}
function makeWord_(m){const template=JSON.parse(DriveApp.getFileById(TEMPLATE_ID).getBlob().getDataAsString('UTF-8'));const blobs=Object.keys(template).map(function(name){const bytes=Utilities.base64Decode(template[name]);if(name==='word/document.xml'){const xml=Utilities.newBlob(bytes).getDataAsString('UTF-8');return Utilities.newBlob(fillWordXml_(xml,m),'application/xml',name)}return Utilities.newBlob(bytes,'application/octet-stream',name)});return Utilities.zip(blobs,'運營紀錄.docx').setContentType('application/vnd.openxmlformats-officedocument.wordprocessingml.document')}
