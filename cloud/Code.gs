function setupAssembly_(){const props=PropertiesService.getScriptProperties();if(props.getProperty('DB_ID')){if(!props.getProperty('TEST_DB_ID')){const test=DriveApp.getFolderById(CFG.root).createFile('2027總會網站串接測試資料.json',JSON.stringify({version:1,districts:{},revision:0,_test:true}),MimeType.PLAIN_TEXT);props.setProperty('TEST_DB_ID',test.getId())}return '共用資料庫已設定'}const root=DriveApp.getFolderById(CFG.root);CFG.sessions.forEach(function(s){DriveApp.getFolderById(s[2]).getName()});DriveApp.getFolderById(CFG.manuscripts).getName();const db=root.createFile('2027總會網站共用資料.json',JSON.stringify({version:1,districts:{},revision:0}),MimeType.PLAIN_TEXT);props.setProperty('DB_ID',db.getId());const test=root.createFile('2027總會網站串接測試資料.json',JSON.stringify({version:1,districts:{},revision:0,_test:true}),MimeType.PLAIN_TEXT);props.setProperty('TEST_DB_ID',test.getId());return '共用資料庫已建立；九個運營資料夾讀取成功'}
function database_(test){const id=PropertiesService.getScriptProperties().getProperty(test?'TEST_DB_ID':'DB_ID');if(!id)throw Error('管理員尚未完成共用資料庫設定');return DriveApp.getFileById(id)}
function read_(test){return JSON.parse(database_(test).getBlob().getDataAsString('UTF-8'))}
function write_(db){db.revision=(db.revision||0)+1;db.updatedAt=new Date().toISOString();database_(db._test===true).setContent(JSON.stringify(db))}
function district_(name){if(!Object.prototype.hasOwnProperty.call(CFG.districts,name))throw Error('地區不符');return CFG.districts[name]}
function empty_(){return {meetings:[],staff:{},counts:{},tasks:{},updatedAt:''}}
function text_(v,max){return typeof v==='string'&&v.length<=(max||10000)}
function validateMeeting_(m){const s=district_(m.district),r=Number(m.round);if(!Number.isInteger(r)||r<1||r>9||m.date!==CFG.sessions[r-1][0]||m.date>=s.date)throw Error('運營週次或日期不符');if(!text_(m.recorder,500)||!m.recorder.trim()||!text_(m.decisions)||!m.decisions.trim())throw Error('請填寫紀錄人與本次決議');const w=m.weekly,n=CFG.sessions.filter(function(v){return v[0]<s.date}).length;if(!w||w.schemaVersion!==2||!Array.isArray(w.plan)||w.plan.length!==n+2)throw Error('運營表格版本不符');w.plan.forEach(function(v,i){const day=i<n?CFG.sessions[i][0]:i===n?s.rehearsal:s.date;if(v.date!==day||!text_(v.time,30)||!text_(v.venue,500))throw Error('日期規劃不符');if(i>=n&&(v.time!==(i===n?s.rehearsalTime:s.time)||v.venue!==(i===n?s.venue:'文化會堂')))throw Error('彩排或正式場次不符')});if(w.sandDate&&!CFG.sessions.slice(0,n).some(function(v){return v[0]===w.sandDate&&v[0]<s.rehearsal}))throw Error('沙推日期不符');if(!Array.isArray(w.targets)||w.targets.length!==3||w.targets.some(function(row){return !Array.isArray(row)||row.length!==5||row.some(function(v){return v!==''&&(!Number.isInteger(v)||v<0||v>100000)})}))throw Error('人數格式不符');[['work',18],['program',6]].forEach(function(pair){if(!Array.isArray(w[pair[0]])||w[pair[0]].length!==pair[1]||w[pair[0]].some(function(v){return !v||!text_(v.person)||!text_(v.notes)||!text_(v.role,200)}))throw Error('人員分工格式不符')});if(JSON.stringify(m).length>180000)throw Error('紀錄內容過長')}
function fileBlob_(b64,name,mime,max){if(typeof b64!=='string'||b64.length>Math.ceil(max*4/3)+8)throw Error('檔案超過大小限制');const bytes=Utilities.base64Decode(b64);if(!bytes.length||bytes.length>max)throw Error('檔案大小不符');return Utilities.newBlob(bytes,mime,name)}
function submit_(db,p){const m=p.record;validateMeeting_(m);if(!/^[a-zA-Z0-9-]{16,80}$/.test(p.requestId||''))throw Error('送出識別不符');const d=db.districts[m.district]||empty_(),round=Number(m.round),old=d.meetings.find(function(v){return v.kind==='weekly-v1'&&Number(v.round)===round});if(old&&old.cloud&&old.cloud.requestId===p.requestId)return {record:old,revision:db.revision};if(old&&old.cloud&&old.cloud.revision!==(p.baseRevision||0))throw Error('CONFLICT:本次紀錄已由其他幹部更新，請重新讀取後再修改');const now=new Date().toISOString(),revision=((old&&old.cloud&&old.cloud.revision)||0)+1;const folder=DriveApp.getFolderById(CFG.sessions[round-1][2]),filename=(db._test?'[串接測試]':'')+m.district+'地區-'+m.date+'-第'+round+'次運營紀錄表-'+p.requestId+'.docx';const existing=folder.getFilesByName(filename);let file;if(existing.hasNext())file=existing.next();else{const blob=fileBlob_(p.docx,filename,'application/vnd.openxmlformats-officedocument.wordprocessingml.document',6000000);const head=blob.getBytes();if((head[0]&255)!==80||(head[1]&255)!==75)throw Error('Word 檔案格式不符');file=folder.createFile(blob)}const clean=JSON.parse(JSON.stringify(m));clean.id=m.district+'-weekly-'+round;clean.updatedAt=now;delete clean.reporting;clean.cloud={requestId:p.requestId,revision:revision,fileId:file.getId(),url:file.getUrl(),folderId:folder.getId(),uploadedAt:now};const i=d.meetings.findIndex(function(v){return v.kind==='weekly-v1'&&Number(v.round)===round});if(i>=0)d.meetings[i]=clean;else d.meetings.push(clean);d.updatedAt=now;db.districts[m.district]=d;write_(db);return {record:clean,revision:db.revision}}
function patch_(db,p){district_(p.district);const d=db.districts[p.district]||empty_(),allowed=['staff','counts','tasks','staffUpdatedAt','countsUpdatedAt','countDate','counter','countNotes','taskNotes','uploadSettings'],change=p.change;if(!change||typeof change!=='object'||Object.keys(change).some(function(k){return allowed.indexOf(k)<0})||JSON.stringify(change).length>180000)throw Error('更新內容不符');if(p.baseUpdatedAt!==(d.updatedAt||''))throw Error('CONFLICT:地區資料已更新，請重新讀取後再修改');if(change.staff)Object.keys(change.staff).forEach(function(k){if(!text_(change.staff[k]))throw Error('人員欄位不符')});if(change.counts){const groups=['壯年部','婦人部','男子部','女子部','未來部','新朋友','教宣對象'];groups.forEach(function(g){['target','invited','actual'].forEach(function(k){if(!change.counts[g]||!Number.isInteger(change.counts[g][k])||change.counts[g][k]<0||change.counts[g][k]>100000)throw Error('全部人數欄位必須填寫')})});if(!text_(change.counter,500)||!change.counter.trim())throw Error('請填寫統計人')}Object.assign(d,change);d.updatedAt=new Date().toISOString();db.districts[p.district]=d;write_(db);return {district:d,revision:db.revision}}
function confirm_(db,p){district_(p.district);const d=db.districts[p.district],m=d&&d.meetings.find(function(v){return v.id===p.id});if(!m||!m.cloud||m.cloud.revision!==p.baseRevision)throw Error('紀錄版本已更新，請重新確認');if(issues_(m).length)throw Error('內容仍有待確認項目');if(!text_(p.by,500)||!p.by.trim())throw Error('請填寫確認人');m.reporting={confirmedAt:new Date().toISOString(),confirmedBy:p.by.trim()};d.updatedAt=new Date().toISOString();write_(db);return {district:d,revision:db.revision}}
function attachment_(db,p){district_(p.district);if(['manuscript','ppt'].indexOf(p.type)<0||!text_(p.name,200)||!text_(p.description,1000)||!/^[-a-zA-Z0-9]{16,80}$/.test(p.requestId||''))throw Error('檔案資料不符');const ext=p.name.split('.').pop().toLowerCase();if((p.type==='ppt'?['ppt','pptx','pdf']:['doc','docx','pdf','txt','odt']).indexOf(ext)<0)throw Error('檔案格式不符');const d=db.districts[p.district]||empty_();d.attachments=d.attachments||[];const old=d.attachments.find(function(v){return v.requestId===p.requestId});if(old)return {attachment:old};const name=(db._test?'[串接測試]':'')+p.district+'地區-'+p.requestId+'-'+p.name.replace(/[\r\n\/\\]/g,'_'),folder=DriveApp.getFolderById(CFG.manuscripts),found=folder.getFilesByName(name),file=found.hasNext()?found.next():folder.createFile(fileBlob_(p.content,name,p.mime||'application/octet-stream',25*1024*1024));const a={id:file.getId(),requestId:p.requestId,type:p.type,name:p.name,description:p.description,url:file.getUrl(),uploadedAt:new Date().toISOString()};d.attachments.push(a);d.updatedAt=a.uploadedAt;db.districts[p.district]=d;write_(db);return {attachment:a,district:d,revision:db.revision}}
function assemblyRequest(q){if(!q||typeof q!=='object')throw Error('請求格式不符');if(q.public===true)return publicRequest_(q);auth_(q.code);if(q.action==='template')return {template:JSON.parse(DriveApp.getFileById(TEMPLATE_ID).getBlob().getDataAsString('UTF-8'))};if(q.action==='load'){const db=read_(q.test===true);return {state:db}}const lock=LockService.getScriptLock();if(!lock.tryLock(25000))throw Error('目前有人正在送出，請稍後重試');try{const db=read_(q.test===true),p=q.payload||{};if(q.action==='submit')return submit_(db,p);if(q.action==='patch')return patch_(db,p);if(q.action==='confirm')return confirm_(db,p);if(q.action==='attachment')return attachment_(db,p);throw Error('不支援的操作')}finally{lock.releaseLock()}}

function issues_(m){if(!m)return [];const issues=[];const missing=v=>!String(v??'').trim();const uncertain=v=>/待確認|未確認|待定|未定|待安排/.test(String(v??''));for(const [key,label] of [['recorder','紀錄人'],['meetingTime','開會時間'],['location','會議地點'],['attendees','出席人員'],['decisions','本次討論與決議']]){if(missing(m[key]))issues.push(label+'未填寫');else if(uncertain(m[key]))issues.push(label+'待確認')}const w=m.weekly||{};let gaps=0;for(let r=0;r<3;r++)for(let c=0;c<5;c++)if(w.targets?.[r]?.[c]===''||w.targets?.[r]?.[c]===undefined)gaps++;if(gaps)issues.push('各部人數目標尚有 '+gaps+' 格未填寫');const work=(w.work||[]).filter(v=>missing(v.person)||uncertain(v.person)||uncertain(v.notes)).length;const program=(w.program||[]).filter(v=>missing(v.person)||uncertain(v.person)||uncertain(v.notes)).length;if(work)issues.push('工作分工尚有 '+work+' 項待確認');if(program)issues.push('程序擔當尚有 '+program+' 項待確認');if(missing(w.districtGoal)||uncertain(w.districtGoal))issues.push('地區祈念目標待確認');if(!w.sandDate)issues.push('沙推運營日期待確認');if(m.pending?.trim()&&!/^(無|無待確認事項|無待辦|不適用)[。\s]*$/.test(m.pending.trim()))issues.push('另有登錄待確認事項');return issues}

