function wordValues_(m){const w=m.weekly,values={district:m.district+'地區',round:'第'+m.round+'次運營',date:m.date,meetingTime:m.meetingTime,location:m.location,recorder:m.recorder,department:m.department,reading:m.reading,attendees:m.attendees,sandDate:w.sandDate,districtGoal:w.districtGoal,personalGoal:w.personalGoal,previous:m.previous,decisions:m.decisions,pending:m.pending,nextAgenda:w.nextAgenda,nextDate:m.nextDate};w.targets.forEach((row,r)=>{row.forEach((v,c)=>values[`targets.${r}.${c}`]=v===''?'未填寫':v);values[`targetTotals.${r}`]=row.some(v=>v==='')?'尚未填齊':row.reduce((a,b)=>a+Number(b),0)});w.work.forEach((v,i)=>{values[`work.${i}.person`]=v.person;values[`work.${i}.notes`]=v.notes});w.program.forEach((v,i)=>{values[`program.${i}.person`]=v.person;values[`program.${i}.notes`]=v.notes});w.plan.forEach((v,i)=>['date','time','venue'].forEach(k=>values[`plan.${i}.${k}`]=v[k]));return values}

